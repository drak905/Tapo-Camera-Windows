    {
      "id": "tpap.spake2p.algorithm",
      "kind": "algorithm",
      "description": "SPAKE2+ (RFC 9383) P-256/SHA-256/HKDF/HMAC, empty idProver/idVerifier. w0||w1 = PBKDF2-HMAC-SHA256(passcode, dev_salt, iterations, 80 bytes), each 40 bytes mod n. X = x*G + w0*M; Z = x*(Y - w0*N); V = w1*(Y - w0*N); TT = 8-byte LE length-prefixed context, '', '', M, N, X, Y, Z, V (uncompressed), w0 (32 bytes); K_main = SHA256(TT); KcP||KcV = HKDF(salt=none, K_main, 'ConfirmationKeys', 64); K_shared = HKDF(.., 'SharedKey', 32); user_confirm = HMAC(KcP, Y); dev_confirm must equal HMAC(KcV, X).",
      "value": {
        "cipher_suite": 1,
        "pbkdf2_bytes": 80,
        "hkdf_infos": [
          "ConfirmationKeys",
          "SharedKey"
        ]
      },
      "evidence": [
        {
          "source": "jadx",
          "file": "tm1/d.java",
          "line": 28,
          "snippet": "PKCS5S2 generator, (digest+8)*2 bytes, two halves mod n"
        },
        {
          "source": "jadx",
          "file": "tm1/a.java",
          "line": 52,
          "snippet": "transcript: 8-byte little-endian length prefixes, points l(false) uncompressed"
        },
        {
          "source": "jadx",
          "file": "tm1/a.java",
          "line": 43,
          "snippet": "kVar.c(bArrB, \"ConfirmationKeys\", true)"
        },
        {
          "source": "jadx",
          "file": "on1/a.java",
          "line": 146,
          "snippet": "different confirmV"
        },
        {
          "source": "external",
          "url": "https://www.rfc-editor.org/rfc/rfc9383",
          "summary": "RFC 9383 protocol and Appendix C test vectors"
        }
      ],
      "confidence": "verified"
    },
