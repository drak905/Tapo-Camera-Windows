    {
      "id": "tpap.extra_crypt",
      "kind": "algorithm",
      "description": "extra_crypt {type, params} reshapes the passcode before PBKDF2 (cameras pass user=null): password_shadow passwd_id 1 = MD5-crypt with passwd_prefix ($1$, else raw passcode), 2 = sha1 hex, 3 = needs user (raw passcode), 5 = SHA-256-crypt ($5$, rounds= honoured, salt <= 16); password_authkey = dict[(c ^ k) % len(dict)] with 187 padding; password_sha_with_salt = sha256 hex of ('admin' if sha_name == 0 else 'user') + b64decode(sha_salt) + passcode.",
      "value": {
        "types": [
